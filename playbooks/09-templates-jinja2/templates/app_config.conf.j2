# Generated by Ansible for {{ inventory_hostname | default('localhost') }}
# App: {{ app_name }} v{{ app_version }}

listen_port = {{ listen_port }}
app_name = {{ app_name | lower }}

{% if enable_logging | bool -%}
logging = enabled
log_file = /var/log/{{ app_name | lower }}.log
{% endif -%}

{% if enable_debug | bool -%}
debug = true
debug_level = verbose
{% endif -%}

upstreams = [
{%- for server in upstreams %}
  {{ server.host }}:{{ server.port }}{% if not loop.last %},{% endif -%}
{%- endfor %}
]
